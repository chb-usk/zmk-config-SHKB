#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        /* zmk,matrix-transform and zmk,kscan are set per-shield in each overlay.
         * Keeping them here would prevent ZMK Studio (USE_PHY_LAYOUTS requires
         * zmk,matrix-transform to be absent from chosen). */
    };

    /* ==========================================================================
       Matrix transform – 62-key split HHKB (rows 0-5 = left, 6-12 = right)
       ========================================================================== */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <13>;
        map = <
        RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(1,0)    RC(6,1)  RC(6,2)  RC(6,3)  RC(6,4)  RC(6,5)  RC(7,0)  RC(7,2)  RC(7,3)  RC(7,4)
        RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(2,0)  RC(2,1)    RC(7,5)  RC(8,0)  RC(8,1)  RC(8,3)  RC(8,4)  RC(8,5)  RC(9,0)  RC(9,1)
        RC(2,3)  RC(2,4)  RC(2,5)  RC(3,0)  RC(3,1)  RC(3,2)    RC(9,2)  RC(9,4)  RC(9,5)  RC(10,0) RC(10,1) RC(10,2) RC(10,3)
        RC(3,4)  RC(3,5)  RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)    RC(11,0) RC(11,1) RC(11,2) RC(11,3) RC(11,4) RC(12,0) RC(12,1)
                          RC(4,5)  RC(5,0)  RC(5,1)  RC(5,2)                       RC(12,2) RC(12,3) RC(12,4)
        >;
    };

    /* ==========================================================================
       Physical layout for Keymap Editor (zmk,physical-layout)
       Key order matches default_transform map exactly (62 keys).
       Coordinates in centikeyunit (100 = 1 key-unit).
         Row stagger: row0=0  row1=+50  row2=+75  row3=+125
         Left/right gap: 200 units (2u)
         Thumb row: pushed inward toward the split center
       ZMK v0.3 does not process these nodes, but the Keymap Editor
       reads them from the DTS source to render the layout.
       ========================================================================== */
    physical_layout_default: physical_layout_default {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        keys  //                     w   h     x     y   rot  rx  ry
            /* ── Row 0 : number row (stagger 0) ──────────────────── */
            /* left  : ESC 1 2 3 4 5 */
            = <&key_physical_attrs 100 100     0     0     0   0   0>
            , <&key_physical_attrs 100 100   100     0     0   0   0>
            , <&key_physical_attrs 100 100   200     0     0   0   0>
            , <&key_physical_attrs 100 100   300     0     0   0   0>
            , <&key_physical_attrs 100 100   400     0     0   0   0>
            , <&key_physical_attrs 100 100   500     0     0   0   0>
            /* right : 6 7 8 9 0 - = \ ` */
            , <&key_physical_attrs 100 100   800     0     0   0   0>
            , <&key_physical_attrs 100 100   900     0     0   0   0>
            , <&key_physical_attrs 100 100  1000     0     0   0   0>
            , <&key_physical_attrs 100 100  1100     0     0   0   0>
            , <&key_physical_attrs 100 100  1200     0     0   0   0>
            , <&key_physical_attrs 100 100  1300     0     0   0   0>
            , <&key_physical_attrs 100 100  1400     0     0   0   0>
            , <&key_physical_attrs 100 100  1500     0     0   0   0>
            , <&key_physical_attrs 100 100  1600     0     0   0   0>
            /* ── Row 1 : QWERTY row (stagger +50) ────────────────── */
            /* left  : TAB(1.5u) Q W E R T */
            , <&key_physical_attrs 150 100    50   100     0   0   0>
            , <&key_physical_attrs 100 100   200   100     0   0   0>
            , <&key_physical_attrs 100 100   300   100     0   0   0>
            , <&key_physical_attrs 100 100   400   100     0   0   0>
            , <&key_physical_attrs 100 100   500   100     0   0   0>
            , <&key_physical_attrs 100 100   600   100     0   0   0>
            /* right : Y U I O P [ ] BSPC(1.5u) */
            , <&key_physical_attrs 100 100   850   100     0   0   0>
            , <&key_physical_attrs 100 100   950   100     0   0   0>
            , <&key_physical_attrs 100 100  1050   100     0   0   0>
            , <&key_physical_attrs 100 100  1150   100     0   0   0>
            , <&key_physical_attrs 100 100  1250   100     0   0   0>
            , <&key_physical_attrs 100 100  1350   100     0   0   0>
            , <&key_physical_attrs 100 100  1450   100     0   0   0>
            , <&key_physical_attrs 150 100  1550   100     0   0   0>
            /* ── Row 2 : home row (stagger +75) ──────────────────── */
            /* left  : CTRL(1.75u) A S D F G */
            , <&key_physical_attrs 175 100    75   200     0   0   0>
            , <&key_physical_attrs 100 100   250   200     0   0   0>
            , <&key_physical_attrs 100 100   350   200     0   0   0>
            , <&key_physical_attrs 100 100   450   200     0   0   0>
            , <&key_physical_attrs 100 100   550   200     0   0   0>
            , <&key_physical_attrs 100 100   650   200     0   0   0>
            /* right : H J K L ; ' ENT(2.25u) */
            , <&key_physical_attrs 100 100   875   200     0   0   0>
            , <&key_physical_attrs 100 100   975   200     0   0   0>
            , <&key_physical_attrs 100 100  1075   200     0   0   0>
            , <&key_physical_attrs 100 100  1175   200     0   0   0>
            , <&key_physical_attrs 100 100  1275   200     0   0   0>
            , <&key_physical_attrs 100 100  1375   200     0   0   0>
            , <&key_physical_attrs 225 100  1475   200     0   0   0>
            /* ── Row 3 : bottom alpha row (stagger +125) ──────────── */
            /* left  : SHIFT(2.25u) Z X C V B */
            , <&key_physical_attrs 225 100   125   300     0   0   0>
            , <&key_physical_attrs 100 100   350   300     0   0   0>
            , <&key_physical_attrs 100 100   450   300     0   0   0>
            , <&key_physical_attrs 100 100   550   300     0   0   0>
            , <&key_physical_attrs 100 100   650   300     0   0   0>
            , <&key_physical_attrs 100 100   750   300     0   0   0>
            /* right : N M , . / RSHFT(1.75u) UP */
            , <&key_physical_attrs 100 100   925   300     0   0   0>
            , <&key_physical_attrs 100 100  1025   300     0   0   0>
            , <&key_physical_attrs 100 100  1125   300     0   0   0>
            , <&key_physical_attrs 100 100  1225   300     0   0   0>
            , <&key_physical_attrs 100 100  1325   300     0   0   0>
            , <&key_physical_attrs 175 100  1425   300     0   0   0>
            , <&key_physical_attrs 100 100  1600   300     0   0   0>
            /* ── Row 4 : thumb cluster (pushed toward split center) ── */
            /* left  : FN(1u) LCTRL(1.5u) LALT(1.5u) SPC(1.5u) — right-aligned */
            , <&key_physical_attrs 100 100   300   400     0   0   0>
            , <&key_physical_attrs 150 100   400   400     0   0   0>
            , <&key_physical_attrs 150 100   550   400     0   0   0>
            , <&key_physical_attrs 150 100   700   400     0   0   0>
            /* right : RALT(1.5u) [trackball 2u gap] RGUI(1.5u) RCTRL(1u) */
            , <&key_physical_attrs 150 100   900   400     0   0   0>
            , <&key_physical_attrs 150 100  1250   400     0   0   0>
            , <&key_physical_attrs 100 100  1400   400     0   0   0>
            ;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_peripheral_split: trackball_peripheral_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };
};

/* XIAO nRF52840 battery voltage divider — standard values.
 * R_top = 1MΩ (VBAT → P0.31/AIN7), R_bottom = 510kΩ (P0.31 → GND via P0.14 open-drain LOW)
 * Maps 4.2V (full LiPo) → 100%, 3.45V → 0%.
 */
&vbatt {
    output-ohms = <510000>;
    full-ohms = <1510000>;
};
